class TouchpadDevice:
    """Live libinput state for the X touchpad device."""

    def __init__(self):
        self.available = shutil.which("xinput") is not None
        self.error = None

    def find(self):
        if not self.available:
            self.error = "xinput is not installed, so the device cannot be read."
            return []
        try:
            out = subprocess.run(
                ["xinput", "list"],
                check=True,
                capture_output=True,
                text=True,
            ).stdout
        except (OSError, subprocess.CalledProcessError) as exc:
            self.error = f"Could not list input devices ({exc})."
            return []
        found = []
        for line in out.splitlines():
            match = NAME_RE.search(line)
            if not match:
                continue
            name, device_id = match.group(1).strip(), int(match.group(2))
            if "touchpad" not in name.lower():
                continue
            found.append((device_id, name))
        if not found:
            self.error = "No touchpad is connected."
        else:
            self.error = None
        return found

    def read(self, device_id):
        out = subprocess.run(
            ["xinput", "list-props", str(device_id)],
            check=True,
            capture_output=True,
            text=True,
        ).stdout
        props = {}
        for line in out.splitlines():
            match = PROP_RE.match(line)
            if match:
                props[match.group(1)] = parse_prop_value(match.group(2))
        node = props.get("Device Node")
        return {
            "speed": float(props.get("libinput Accel Speed", 0.0)),
            "tap": as_bool(props.get("libinput Tapping Enabled", 0)),
            "drag": as_bool(props.get("libinput Tapping Drag Enabled", 0)),
            "middle": as_bool(props.get("libinput Middle Emulation Enabled", 0)),
            "click": as_pair(props.get("libinput Click Method Enabled")),
            "click_default": as_pair(props.get("libinput Click Method Enabled Default")),
            "send": as_pair(props.get("libinput Send Events Mode Enabled")),
            "natural": as_bool(props.get("libinput Natural Scrolling Enabled", 0)),
            "scroll": props.get("libinput Scroll Method Enabled"),
            "node": node if isinstance(node, str) else "",
        }

    def set_prop(self, device_id, name, *values):
        subprocess.run(
            ["xinput", "set-prop", str(device_id), name, *[str(v) for v in values]],
            check=True,
            capture_output=True,
            text=True,
        )

    def apply(self, saved):
        """Push saved settings onto every touchpad. Returns (devices, error)."""
        devices = self.find()
        if not devices:
            return devices, self.error
        errors = []
        for device_id, name in devices:
            try:
                current = self.read(device_id)
                default_click = current["click_default"] or (1, 0)
                click = CLICK_PAIRS.get(saved["click-method"], default_click)
                send = SEND_PAIRS.get(saved["send-events"], (0, 0))
                gesture = gesture_from_flags(
                    saved["two-finger-scrolling-enabled"],
                    saved["edge-scrolling-enabled"],
                )
                scroll = GESTURE_VALUES[gesture]
                self.set_prop(device_id, "libinput Accel Speed", f"{saved['speed']:.2f}")
                self.set_prop(
                    device_id,
                    "libinput Natural Scrolling Enabled",
                    int(saved["natural-scroll"]),
                )
                self.set_prop(
                    device_id,
                    "libinput Scroll Method Enabled",
                    scroll[0],
                    scroll[1],
                    scroll[2],
                )
                self.set_prop(device_id, "libinput Tapping Enabled", int(saved["tap-to-click"]))
                self.set_prop(
                    device_id, "libinput Tapping Drag Enabled", int(saved["tap-and-drag"])
                )
                self.set_prop(
                    device_id,
                    "libinput Middle Emulation Enabled",
                    int(saved["middle-click-emulation"]),
                )
                self.set_prop(device_id, "libinput Click Method Enabled", click[0], click[1])
                self.set_prop(device_id, "libinput Send Events Mode Enabled", send[0], send[1])
            except (OSError, subprocess.CalledProcessError) as exc:
                detail = exc.stderr.strip() if getattr(exc, "stderr", None) else str(exc)
                errors.append(f"{name}: {detail}")
        return devices, "; ".join(errors) if errors else None


def saved_matches(saved, live):
    """Return human-readable differences between saved settings and the device."""
    if live is None:
        return ["The touchpad could not be read."]
    diffs = []
    if abs(live["speed"] - saved["speed"]) >= 0.02:
        diffs.append(
            f"speed is {live['speed']:.2f}, saved is {saved['speed']:.2f}"
        )
    if live["tap"] != saved["tap-to-click"]:
        diffs.append(
            "tap to click is " + ("on" if live["tap"] else "off")
        )
    if live["drag"] != saved["tap-and-drag"]:
        diffs.append(
            "tap and drag is " + ("on" if live["drag"] else "off")
        )
    if live["middle"] != saved["middle-click-emulation"]:
        diffs.append(
            "middle-click emulation is " + ("on" if live["middle"] else "off")
        )
    expected_click = CLICK_PAIRS.get(saved["click-method"], live["click_default"])
    if live["click"] != expected_click:
        diffs.append("click actions differ from the saved choice")
    expected_send = SEND_PAIRS.get(saved["send-events"])
    if expected_send and live["send"] != expected_send:
        diffs.append("the on/off mode differs from the saved choice")
    if "natural" in live and live["natural"] != saved["natural-scroll"]:
        diffs.append(
            "scroll direction is " + ("down motion scrolls up" if live["natural"] else "down motion scrolls down")
        )
    live_scroll = live.get("scroll")
    if isinstance(live_scroll, tuple) and len(live_scroll) >= 2:
        expected = GESTURE_VALUES[
            gesture_from_flags(
                saved["two-finger-scrolling-enabled"], saved["edge-scrolling-enabled"]
            )
        ]
        if (int(live_scroll[0]), int(live_scroll[1])) != (expected[0], expected[1]):
            diffs.append("the scroll gesture differs from the saved choice")
    return diffs


