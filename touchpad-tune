        self.set_border_width(0)

        self.device = TouchpadDevice()
        self.settings = Gio.Settings.new(SCHEMA)
        self._updating = False
        self._writing = False
        self._speed_src = None
        self._refresh_src = None
        self._decay_running = False

        self._last_motion = None
        self.trail = []
        self.buttons_down = set()
        self.flash_until = {}
        self.last_click_name = None
        self.speed_now = 0.0
        self.peak = 0.0
        self.moving_until = 0
        self.peak_until = 0

        self._build()
        self._load_widgets()
        self.refresh_status()
        self.settings.connect("changed", self._on_settings_changed)
        self.connect("map", self._queue_clamp)

    def _queue_clamp(self, *_args):
        GLib.idle_add(self._clamp_to_workarea)

    def _clamp_to_workarea(self):
        display = Gdk.Display.get_default()
        gdk_window = self.get_window()
        if display is None or gdk_window is None:
            return False
        monitor = display.get_monitor_at_window(gdk_window)
        if monitor is None:
            return False
        work = monitor.get_workarea()
        x, y = self.get_position()
        width, height = self.get_size()
        width = min(width, work.width)
        height = min(height, work.height)
        x = max(work.x, min(x, work.x + work.width - width))
        y = max(work.y, min(y, work.y + work.height - height))
        self.resize(width, height)
        self.move(x, y)
        return False

