    def _window_size(self):
        """Size the window to the monitor work area.

        Gdk reports this display in application pixels (the same units as
        set_default_size). The height has to stay inside the work area or the
        try-out pad is left off the bottom of the screen.
        """
        display = Gdk.Display.get_default()
        monitor = None
        if display is not None:
            monitor = display.get_primary_monitor() or (
                display.get_monitor(0) if display.get_n_monitors() else None
            )
        if monitor is None:
            return 500, 720
        work = monitor.get_workarea()
        # Stay inside the work area. Requesting the full height makes the
        # window manager slide the title bar off the top of this display.
        width = min(520, max(420, work.width - 80))
        height = min(830, max(560, work.height - 130))
        return width, height

    def _section(self, text):
        label = Gtk.Label(label=text, xalign=0)
        label.get_style_context().add_class("section")
        return label

    def _switch_row(self, listbox, title, subtitle):
        row = Gtk.ListBoxRow()
        row.set_activatable(False)
        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        box.set_margin_start(12)
        box.set_margin_end(12)
        box.set_margin_top(6)
        box.set_margin_bottom(6)
        text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        text.set_hexpand(True)
        title_label = Gtk.Label(label=title, xalign=0)
        sub = Gtk.Label(label=subtitle, xalign=0)
        sub.set_line_wrap(True)
        sub.set_max_width_chars(40)
        sub.get_style_context().add_class("dim-label")
        text.pack_start(title_label, False, False, 0)
        text.pack_start(sub, False, False, 0)
        switch = Gtk.Switch()
        switch.set_valign(Gtk.Align.CENTER)
        switch.set_halign(Gtk.Align.END)
        box.pack_start(text, True, True, 0)
        box.pack_start(switch, False, False, 0)
        row.add(box)
        listbox.add(row)
        return switch

    def _saved(self):
        return {
            "speed": self.settings.get_double("speed"),
            "tap-to-click": self.settings.get_boolean("tap-to-click"),
            "tap-and-drag": self.settings.get_boolean("tap-and-drag"),
            "middle-click-emulation": self.settings.get_boolean("middle-click-emulation"),
            "click-method": self.settings.get_string("click-method"),
            "send-events": self.settings.get_string("send-events"),
            "natural-scroll": self.settings.get_boolean("natural-scroll"),
            "two-finger-scrolling-enabled": self.settings.get_boolean(
                "two-finger-scrolling-enabled"
            ),
            "edge-scrolling-enabled": self.settings.get_boolean("edge-scrolling-enabled"),
        }

    def _load_widgets(self):
        saved = self._saved()
        self._updating = True
        try:
            self.speed_scale.set_value(saved["speed"])
            self.speed_value.set_text(speed_phrase(saved["speed"]))
            self.tap_switch.set_active(saved["tap-to-click"])
            self.drag_switch.set_active(saved["tap-and-drag"])
            self.middle_switch.set_active(saved["middle-click-emulation"])
            self.method_combo.set_active_id(saved["click-method"])
            self.send_combo.set_active_id(saved["send-events"])
            direction = direction_from_natural(saved["natural-scroll"])
            self.direction_combo.set_active_id(direction)
            self.direction_hint.set_text(direction_hint(direction))
            gesture = gesture_from_flags(
                saved["two-finger-scrolling-enabled"],
                saved["edge-scrolling-enabled"],
            )
            self.gesture_combo.set_active_id(gesture)
            self.gesture_hint.set_text(gesture_hint(gesture))
            self.method_hint.set_text(click_hint(saved["click-method"], getattr(self, "_default_click", (1, 0))))
            self.drag_switch.set_sensitive(saved["tap-to-click"])
        finally:
            self._updating = False

    def _on_settings_changed(self, _settings, key):
        if self._writing:
            return
        if key not in RESET_KEYS and key != "send-events":
            return
        self._load_widgets()
        self.refresh_status()

    def _write(self, key, value):
        self._writing = True
        try:
            if isinstance(value, bool):
                self.settings.set_boolean(key, value)
            elif isinstance(value, float):
                self.settings.set_double(key, value)
            else:
                self.settings.set_string(key, value)
        finally:
            self._writing = False

    def _push(self, reschedule=True):
        _devices, error = self.device.apply(self._saved())
        self._apply_error = error
        if reschedule:
            if self._refresh_src:
                GLib.source_remove(self._refresh_src)
            self._refresh_src = GLib.timeout_add(200, self._refresh_later)

    def _refresh_later(self):
        self._refresh_src = None
        self.refresh_status()
        return False

    def _commit_speed(self):
        self._speed_src = None
        value = round(self.speed_scale.get_value(), 2)
        self._write("speed", value)
        self._push()
        return False

    def _on_speed(self, scale):
        if self._updating:
            return
        self.speed_value.set_text(speed_phrase(scale.get_value()))
        if self._speed_src:
            GLib.source_remove(self._speed_src)
        self._speed_src = GLib.timeout_add(60, self._commit_speed)

    def _on_tap(self, switch, _pspec):
        if self._updating:
            return
        active = switch.get_active()
        self.drag_switch.set_sensitive(active)
        self._write("tap-to-click", active)
        self._push()

    def _on_drag(self, switch, _pspec):
        if self._updating:
            return
        self._write("tap-and-drag", switch.get_active())
        self._push()

    def _on_middle(self, switch, _pspec):
        if self._updating:
            return
        self._write("middle-click-emulation", switch.get_active())
        self._push()

    def _on_method(self, combo):
        if self._updating:
            return
        method = combo.get_active_id()
        if not method:
            return
        self.method_hint.set_text(click_hint(method, getattr(self, "_default_click", (1, 0))))
        self._write("click-method", method)
        self._push()

    def _on_direction(self, combo):
        if self._updating:
            return
        which = combo.get_active_id()
        if not which:
            return
        self.direction_hint.set_text(direction_hint(which))
        self._write("natural-scroll", which == "up")
        self._push()

    def _on_gesture(self, combo):
        if self._updating:
            return
        gesture = combo.get_active_id()
        if gesture == "twofinger":
            flags = (("two-finger-scrolling-enabled", True), ("edge-scrolling-enabled", False))
        elif gesture == "edge":
            flags = (("two-finger-scrolling-enabled", False), ("edge-scrolling-enabled", True))
        elif gesture == "none":
            flags = (("two-finger-scrolling-enabled", False), ("edge-scrolling-enabled", False))
        else:
            return
        self.gesture_hint.set_text(gesture_hint(gesture))
        self._writing = True
        try:
            for key, value in flags:
                self.settings.set_boolean(key, value)
        finally:
            self._writing = False
        self._push()

    def _on_send(self, combo):
        if self._updating:
            return
        mode = combo.get_active_id()
        if not mode:
            return
        self._write("send-events", mode)
        self._push()

    def _on_reset(self, *_args):
        self._writing = True
        try:
            for key in RESET_KEYS:
                self.settings.reset(key)
        finally:
            self._writing = False
        self._load_widgets()
        self._push()

    def refresh_status(self):
        saved = self._saved()
        devices = self.device.find()
        live = None
        if devices:
            try:
                live = self.device.read(devices[0][0])
            except (OSError, subprocess.CalledProcessError) as exc:
                self.device.error = str(exc)
        if devices:
            device_id, name = devices[0]
            extra = f" · id {device_id}"
            if live and live["node"]:
                extra += f" · {live['node']}"
            self.device_label.set_text(name)
            self.device_label.set_tooltip_text(name + extra)
        else:
            self.device_label.set_text("Touchpad")
            self.device_label.set_tooltip_text("")

        if live is not None and live.get("click_default"):
            self._default_click = live["click_default"]
            method = self.method_combo.get_active_id()
            if method:
                self.method_hint.set_text(click_hint(method, self._default_click))

        if live is None:
            self.status_label.set_text(self.device.error or "The touchpad could not be read.")
            self.detail_label.set_text(
                "Saved settings stay on this account and apply when a touchpad is available."
            )
            self.apply_button.set_visible(False)
            return

        diffs = saved_matches(saved, live)
        error = getattr(self, "_apply_error", None)
        if error:
            self.status_label.set_text("Could not update the device.")
            self.detail_label.set_text(error)
            self.apply_button.set_visible(True)
            return
        if diffs:
            self.status_label.set_text("Saved settings are not on the device yet.")
            self.detail_label.set_text("The touchpad reports: " + "; ".join(diffs) + ".")
            self.apply_button.set_visible(True)
        else:
            self.status_label.set_text("Saved settings match the touchpad.")
            send = dict(SEND_CHOICES).get(saved["send-events"], saved["send-events"])
            detail = (
                f"On the device: speed {live['speed']:.2f}, "
                f"tap to click {'on' if live['tap'] else 'off'}, "
                f"tap and drag {'on' if live['drag'] else 'off'}, "
                f"{click_phrase(saved['click-method'], live['click_default'])}, "
                f"middle click {'on' if live['middle'] else 'off'}, "
                f"{'down motion scrolls up' if saved['natural-scroll'] else 'down motion scrolls down'}, "
                f"{dict(GESTURE_CHOICES).get(gesture_from_flags(saved['two-finger-scrolling-enabled'], saved['edge-scrolling-enabled']), 'scroll')}. "
                f"Touchpad is {send.lower()}."
            )
            self.detail_label.set_text(detail)
            self.apply_button.set_visible(False)

    def _poke(self):
        self._update_try_label()
        self.pad.queue_draw()
        if not self._decay_running:
            self._decay_running = True
            GLib.timeout_add(50, self._decay)

    def _decay(self):
        now = GLib.get_monotonic_time() // 1000
        alive = (
            bool(self.buttons_down)
            or now < self.moving_until
            or now < self.peak_until
            or any(now < until for until in self.flash_until.values())
        )
        self._update_try_label()
        self.pad.queue_draw()
        if not alive:
            self._decay_running = False
        return alive

    def _update_try_label(self):
        now = GLib.get_monotonic_time() // 1000
        if self.last_click_name:
            click = f"Last click: {self.last_click_name}"
        else:
            click = "No click yet"
        if now < self.moving_until:
            motion = f"moving at {self.speed_now:.0f} px/s"
        elif self.peak > 0 and now < self.peak_until:
            motion = f"last sweep peaked at {self.peak:.0f} px/s"
        else:
            motion = "move across the box to measure speed"
        self.try_label.set_text(f"{click} · {motion}.")

    def _on_press(self, _widget, event):
        button = int(event.button)
        self.buttons_down.add(button)
        self.last_click_name = BUTTON_NAMES.get(button, f"Button {button}")
        self.flash_until[button] = (GLib.get_monotonic_time() // 1000) + 700
        self._poke()
        return True

    def _on_release(self, _widget, event):
        button = int(event.button)
        self.buttons_down.discard(button)
        self.flash_until[button] = (GLib.get_monotonic_time() // 1000) + 700
        self._poke()
        return True

    def _on_motion(self, _widget, event):
        now_event = event.time
        if self._last_motion is not None:
            last_x, last_y, last_t = self._last_motion
            dt = (now_event - last_t) / 1000.0
            if 0 < dt < 0.2:
                inst = math.hypot(event.x - last_x, event.y - last_y) / dt
                self.speed_now = self.speed_now * 0.65 + inst * 0.35
                if inst > self.peak:
                    self.peak = inst
                now = GLib.get_monotonic_time() // 1000
                self.moving_until = now + 180
                self.peak_until = now + 1400
        self._last_motion = (event.x, event.y, now_event)
        self.trail.append((event.x, event.y, now_event))
        if len(self.trail) > 48:
            del self.trail[:-48]
        self._poke()
        return False

    def _on_leave(self, _widget, _event):
        self._last_motion = None
        self.trail.clear()
        self.buttons_down.clear()
        self.moving_until = 0
        self._poke()
        return False

    def _color(self, name, fallback):
        found, color = self.pad.get_style_context().lookup_color(name)
        if found:
            return color
        color = Gdk.RGBA()
        color.parse(fallback)
        return color

    def _draw_pad(self, widget, cr):
        width = widget.get_allocated_width()
        height = widget.get_allocated_height()
        radius = 10
        base = self._color("theme_base_color", "#ffffff")
        fg = self._color("theme_fg_color", "#202020")
        accent = self._color("theme_selected_bg_color", "#1a73e8")
        accent_fg = self._color("theme_selected_fg_color", "#ffffff")

        cr.new_sub_path()
        cr.arc(width - radius, radius, radius, -math.pi / 2, 0)
        cr.arc(width - radius, height - radius, radius, 0, math.pi / 2)
        cr.arc(radius, height - radius, radius, math.pi / 2, math.pi)
        cr.arc(radius, radius, radius, math.pi, 3 * math.pi / 2)
        cr.close_path()
        cr.set_source_rgba(base.red, base.green, base.blue, 1)
        cr.fill_preserve()
        cr.set_source_rgba(fg.red, fg.green, fg.blue, 0.18)
        cr.set_line_width(1)
        cr.stroke()

        if len(self.trail) >= 2:
            cr.set_line_width(2.6)
            cr.set_line_cap(cairo.LINE_CAP_ROUND)
            newest = self.trail[-1][2]
            for (x0, y0, _t0), (x1, y1, t1) in zip(self.trail, self.trail[1:]):
                alpha = max(0.0, 1.0 - (newest - t1) / 350.0)
                cr.set_source_rgba(accent.red, accent.green, accent.blue, alpha)
                cr.move_to(x0, y0)
                cr.line_to(x1, y1)
                cr.stroke()

        prompt = widget.create_pango_layout("Move and click here")
        prompt.set_font_description(Pango.FontDescription("Sans 11"))
        pw, ph = prompt.get_pixel_size()
        cr.set_source_rgba(fg.red, fg.green, fg.blue, 0.55)
        cr.move_to((width - pw) / 2, 16)
        PangoCairo.show_layout(cr, prompt)

        now = GLib.get_monotonic_time() // 1000
        labels = ((1, "Left"), (2, "Middle"), (3, "Right"))
        gap = 8
        pad = 14
        pill_h = 28
        pill_w = (width - pad * 2 - gap * 2) / 3
        pill_y = height - pad - pill_h
        for index, (button, text) in enumerate(labels):
            hot = button in self.buttons_down or now < self.flash_until.get(button, 0)
            x = pad + index * (pill_w + gap)
            cr.new_sub_path()
            r = pill_h / 2
            cr.arc(x + pill_w - r, pill_y + r, r, -math.pi / 2, math.pi / 2)
            cr.arc(x + r, pill_y + r, r, math.pi / 2, 3 * math.pi / 2)
            cr.close_path()
            if hot:
                cr.set_source_rgba(accent.red, accent.green, accent.blue, 0.95)
            else:
                cr.set_source_rgba(fg.red, fg.green, fg.blue, 0.08)
            cr.fill()
            layout = widget.create_pango_layout(text)
            layout.set_font_description(Pango.FontDescription("Sans 10"))
            tw, th = layout.get_pixel_size()
            if hot:
                cr.set_source_rgba(accent_fg.red, accent_fg.green, accent_fg.blue, 1)
            else:
                cr.set_source_rgba(fg.red, fg.green, fg.blue, 0.75)
            cr.move_to(x + (pill_w - tw) / 2, pill_y + (pill_h - th) / 2)
            PangoCairo.show_layout(cr, layout)
        return False


def main():
    source = Gio.SettingsSchemaSource.get_default()
    if source is None or source.lookup(SCHEMA, True) is None:
        print(f"Missing settings schema {SCHEMA}", file=sys.stderr)
        return 1
    app = Gtk.Application(
        application_id="local.touchpad.Tune", flags=Gio.ApplicationFlags.FLAGS_NONE
    )

    def activate(_app):
        windows = _app.get_windows()
        if windows:
            windows[0].present()
            return
        window = TuneWindow(_app)
        window.show_all()
        window.apply_button.set_visible(False)
        window.refresh_status()

    app.connect("activate", activate)
    return app.run(sys.argv)


if __name__ == "__main__":
    sys.exit(main())
