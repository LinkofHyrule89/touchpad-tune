NAME_RE = re.compile(r"↳\s+(.+?)\s+id=(\d+)")
PROP_RE = re.compile(r"^\t(.+?) \(\d+\):\t(.*)$")


def parse_prop_value(raw):
    raw = raw.strip()
    if raw == "<no items>":
        return ()
    if len(raw) >= 2 and raw[0] == '"' and raw[-1] == '"':
        return raw[1:-1]
    values = []
    for part in raw.split(","):
        part = part.strip()
        if re.fullmatch(r"-?\d+", part):
            values.append(int(part))
        else:
            try:
                values.append(float(part))
            except ValueError:
                values.append(part)
    if len(values) == 1:
        return values[0]
    return tuple(values)


def as_pair(value):
    if isinstance(value, tuple):
        if len(value) < 2:
            return None
        return (int(value[0]), int(value[1]))
    return None


def as_bool(value):
    if isinstance(value, tuple):
        return bool(value[0]) if value else False
    return bool(int(value))


def speed_phrase(value):
    shown = f"{value:.2f}"
    if abs(value) < 0.02:
        return f"{shown} · Default"
    if value > 0:
        return f"{shown} · Faster"
    return f"{shown} · Slower"


def click_phrase(method, default_pair):
    if method == "default":
        baked = CLICK_FROM_PAIR.get(default_pair)
        if baked == "areas":
            return "Default (bottom corners on this pad)"
        if baked == "fingers":
            return "Default (finger count on this pad)"
        if baked == "none":
            return "Default (software buttons off on this pad)"
        return "Default device behavior"
    return dict(CLICK_CHOICES).get(method, method)


